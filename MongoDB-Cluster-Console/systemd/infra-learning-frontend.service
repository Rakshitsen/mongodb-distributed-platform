[Unit]
Description=MongoDB Infra Learning Platform frontend
After=network.target mongod.service

[Service]
Type=simple
User=mongo-app
WorkingDirectory=/opt/MongoDB-Infrastructure-Platform/MongoDB-Cluster-Console/frontend
EnvironmentFile=/opt/MongoDB-Infrastructure-Platform/MongoDB-Cluster-Console/frontend/.env
ExecStart=/opt/MongoDB-Infrastructure-Platform/MongoDB-Cluster-Console/frontend/npm run dev -- --host 0.0.0.0
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

